<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production Configuration: Strictly enforce TLS/HTTPS with system CAs across all connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
