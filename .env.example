# ==============================================================================
# KeraLink Platform — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in real production secrets. Never commit .env!
# ==============================================================================

# Core Django Security
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
JWT_SIGNING_KEY=generate-a-separate-strong-random-jwt-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,keralink.travel,api.keralink.travel,my-tourism.onrender.com

# CORS & CSRF Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://keralink.travel,https://app.keralink.travel,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://keralink.travel,https://app.keralink.travel,http://localhost:3000

# Database & Cache (PostgreSQL + PostGIS, Redis)
DATABASE_URL=postgresql://keralink_user:keralink_secure_password@localhost:5432/keralink_db
REDIS_URL=redis://localhost:6379/0
USE_POSTGIS=false

# Email (SMTP / Transactional Dispatch)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@keralink.travel
EMAIL_HOST_PASSWORD=your-secure-app-password-here
DEFAULT_FROM_EMAIL=KeraLink Tourism <noreply@keralink.travel>

# AI & Weather External Integrations
GEMINI_API_KEY=your-google-gemini-api-key-here
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Payment Gateway (Razorpay)
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_placeholder_secret

# Observability
SENTRY_DSN=
